# Copier ce fichier en .env et compléter (l'installateur le fait pour vous).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_HTTPS=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=http://localhost:8010

# IA facultative (console.anthropic.com > API Keys) : bouton « Améliorer avec l'IA »
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Connexion facultative à FORM'AO (catalogue, profil, acheteurs publics). Voir docs/API_FORMAO.md
FORMAO_URL=
FORMAO_JETON=

# Option LinkedIn (à activer aussi dans Paramètres). Application à créer sur
# https://www.linkedin.com/developers/apps avec « Sign In with LinkedIn using OpenID Connect »
# et « Share on LinkedIn ». URL de redirection : {BASE_URL}/prospection/linkedin/retour/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202609

# E-mails (facultatif) : par défaut, ils s'affichent dans le journal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
